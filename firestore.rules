rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return false; } // App has no admin feature
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'date', 'title', 'completed']) &&
             data.userId == request.auth.uid &&
             data.date is string && data.date.size() <= 20 &&
             (!('endDate' in data) || (data.endDate is string && data.endDate.size() <= 20)) &&
             data.title is string && data.title.size() <= 1000 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 20)) &&
             data.completed is bool &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidDayImages(data) {
      return data.keys().hasAll(['userId', 'date', 'images']) &&
             data.userId == request.auth.uid &&
             data.date is string && data.date.size() <= 20 &&
             data.images is list && data.images.size() <= 50 &&
             data.updatedAt is number;
    }

    match /users/{userId} {
      match /tasks/{taskId} {
        allow read: if isSignedIn() && userId == request.auth.uid;
        
        allow create: if isSignedIn() && 
                         userId == request.auth.uid &&
                         isValidId(taskId) &&
                         isValidTask(incoming()) &&
                         incoming().createdAt == request.time.toMillis() &&
                         incoming().updatedAt == request.time.toMillis();
                         
        allow update: if isSignedIn() && 
                         userId == request.auth.uid &&
                         isValidId(taskId) &&
                         isValidTask(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['date', 'endDate', 'title', 'description', 'color', 'completed', 'updatedAt']) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time.toMillis();
                         
        allow delete: if isSignedIn() && userId == request.auth.uid && isValidId(taskId);
        allow list: if isSignedIn() && userId == request.auth.uid;
      }
      
      match /dayImages/{dayImageId} {
        allow read: if isSignedIn() && userId == request.auth.uid;
        
        allow create: if isSignedIn() && 
                         userId == request.auth.uid &&
                         isValidId(dayImageId) &&
                         isValidDayImages(incoming()) &&
                         (incoming().images.size() == 0 || incoming().images[0] is string) &&
                         incoming().updatedAt == request.time.toMillis();
                         
        allow update: if isSignedIn() && 
                         userId == request.auth.uid &&
                         isValidId(dayImageId) &&
                         isValidDayImages(incoming()) &&
                         (incoming().images.size() == 0 || incoming().images[0] is string) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['images', 'updatedAt']) &&
                         incoming().date == existing().date &&
                         incoming().updatedAt == request.time.toMillis();
                         
        allow delete: if isSignedIn() && userId == request.auth.uid;
        allow list: if isSignedIn() && userId == request.auth.uid;
      }
    }
  }
}
